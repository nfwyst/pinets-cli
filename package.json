{
  "name": "@nfwyst/pinets-cli",
  "version": "0.1.15-nfwyst.9",
  "description": "The nfwyst-maintained CLI for running Pine Script indicators with PineTS.",
  "keywords": [
    "Pine",
    "Script",
    "PineTS",
    "Indicators",
    "Finance",
    "Quant",
    "Trading",
    "Backtesting",
    "CLI"
  ],
  "homepage": "https://github.com/nfwyst/pinets-cli#readme",
  "bugs": {
    "url": "https://github.com/nfwyst/pinets-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nfwyst/pinets-cli.git"
  },
  "license": "AGPL-3.0-or-later AND AGPL-3.0-only",
  "author": "Alaa-eddine KADDOURI",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.4",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "bin": {
    "pinets": "dist/pinets-cli.min.cjs",
    "pinets-cli": "dist/pinets-cli.cjs"
  },
  "files": [
    "dist/pinets-cli.min.cjs",
    "dist/pinets-cli.min.cjs.map",
    "dist/pinets-cli.cjs",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts prod",
    "build:dev": "bun run scripts/build.ts dev",
    "build:prod": "bun run scripts/build.ts prod",
    "check": "bunx --bun tsc --noEmit",
    "test": "bun run build:prod && bun test --max-concurrency 1 test/*.test.mjs",
    "prepublishOnly": "bun run check && bun run test",
    "clean": "bun run scripts/clean.ts"
  },
  "devDependencies": {
    "@nfwyst/pinets": "0.11.1-nfwyst.8",
    "@types/bun": "^1.4.3",
    "commander": "^14.0.3",
    "typescript": "^5.7.0"
  }
}
